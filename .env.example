# Same Supabase project the web app (nimble-coaching) uses — this app shares one backend.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# The web app's URL, for anything that still needs to link out to it.
EXPO_PUBLIC_WEB_URL=https://nimble-coaching.vercel.app

# Legal pages and support contact shown in Settings. Must be live, real URLs before
# submitting to either app store.
EXPO_PUBLIC_PRIVACY_URL=https://nimble-coaching.vercel.app/privacy
EXPO_PUBLIC_TERMS_URL=https://nimble-coaching.vercel.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@nimble.app
